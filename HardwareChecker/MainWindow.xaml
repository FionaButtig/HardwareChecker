<Window x:Class="HardwareInfoApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hardware Info Viewer"
        Height="660"
        Width="950"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="System Hardware Information"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <Button Content="Hardware Scannen"
                        Height="35"
                        Margin="0,0,0,10"
                        Background="#007ACC"
                        Foreground="White"
                        BorderThickness="0"
                        Click="ScanButton_Click"/>

                <ListBox x:Name="SnapshotList"
                         Height="380"
                         Background="#252526"
                         Foreground="White"
                         BorderBrush="#3C3C3C"
                         Padding="5"
                         DisplayMemberPath="DisplayName"
                         SelectionChanged="SnapshotList_SelectionChanged"/>

                <Button Content="Eintrag umbenennen"
                        Margin="0,10,0,5"
                        Height="30"
                        Click="RenameButton_Click"/>

                <Button Content="Hardware bearbeiten"
                        Margin="0,5,0,5"
                        Height="30"
                        Click="EditHardwareButton_Click"/>

                <Button Content="Eintrag Löschen"
                        Height="30"
                        Background="#8B2E2E"
                        Foreground="White"
                        Click="DeleteButton_Click"/>

            </StackPanel>

            <ScrollViewer Grid.Column="1"
                          Margin="15,0,0,0"
                          VerticalScrollBarVisibility="Auto">

                <StackPanel x:Name="InfoPanel"/>

            </ScrollViewer>

        </Grid>
    </Grid>
</Window>